{
  "name": "wall-flip",
  "author": "Eduardo Chiaro",
  "version": "3.3.0",
  "keywords": [
    "pebble-watchface",
    "flip",
    "wall",
    "configurable"
  ],
  "private": true,
  "scripts": {
    "build": "pebble clean && pebble build && ./scripts/pack-pbw.sh",
    "test": "./test/run.sh",
    "emulator": "npm run build && pebble install --emulator ",
    "e": "npm run build && pebble install --emulator",
    "phone": "npm run build && pebble install --phone",
    "p": "npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "c": "pebble emu-app-config --emulator",
    "logs": "pebble logs",
    "font": "node scripts/gen-svg-font.js resources/fonts/Lekton-Bold.ttf resources/fonts/mono.svg mono \" %-./0123456789:@ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz°\" && fctx-compiler resources/fonts/mono.svg && mv resources/mono.ffont resources/fonts/mono.ffont"
  },
  "pebble": {
    "displayName": "Wall Flip",
    "uuid": "8d530349-f7cc-4337-b077-e2af3337783e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "health",
      "configurable"
    ],
    "messageKeys": [
      "YEAR_TOP",
      "BLOCK_BAND",
      "BLOCK_TOP_LEFT",
      "BLOCK_TOP_RIGHT",
      "BLOCK_BOTTOM_LEFT",
      "BLOCK_BOTTOM_RIGHT",
